#!/usr/bin/env sh
# Runs after every `git merge` or `git pull` that produced a merge commit.
# We can't block the merge (it's already committed by the time this fires),
# so we do the next best thing: surface drift loudly enough that the user
# catches it before the next push.
#
# Mirrors the CI `lint` job in .github/workflows/verify.yml — if this
# hook stays silent, CI will also pass.
#
# Skips silently when running inside CI (GITHUB_ACTIONS is set) or when
# the user has exported FAST_SKIP_DRIFT_HOOK=1 for a one-off merge where
# they plan to re-run lint manually.

if [ -n "$GITHUB_ACTIONS" ] || [ "$FAST_SKIP_DRIFT_HOOK" = "1" ]; then
  exit 0
fi

# Bail out cheaply if the merge didn't touch src/ — pure doc/config merges
# can't introduce code drift. `git diff ORIG_HEAD HEAD` shows what came in.
if ! git diff --name-only ORIG_HEAD HEAD 2>/dev/null | grep -q '^src/'; then
  exit 0
fi

echo ""
echo "━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━"
echo "post-merge drift check — scanning merged src/ changes"
echo "━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━"

LINT_OUT=$(npm run lint 2>&1)
fail=0

if echo "$LINT_OUT" | grep -q "no-restricted-imports"; then
  echo ""
  echo "❌ Stale pre-folderization import detected in merged code."
  echo "   The rename table is in .claude/skills/merging-main/SKILL.md."
  echo "$LINT_OUT" | grep -B 1 "no-restricted-imports" || true
  fail=1
fi

if echo "$LINT_OUT" | grep -q "no-restricted-syntax"; then
  echo ""
  echo "❌ API route uses imperative validation (request.json / searchParams)."
  echo "   Migrate using .claude/skills/next-app-router/api-routes.md."
  echo "$LINT_OUT" | grep -B 1 "no-restricted-syntax" || true
  fail=1
fi

if [ "$fail" -eq 0 ]; then
  echo "✓ no drift — merge is aligned with the agentic patterns"
else
  echo ""
  echo "━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━"
  echo "  Run /realign in a Claude Code session OR fix manually before"
  echo "  pushing — CI's verify workflow will block the PR otherwise."
  echo "━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━"
fi

# Always exit 0 — the merge already happened; blocking via non-zero
# exit would only cause the user to think the merge itself failed.
exit 0
