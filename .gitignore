# Logs
logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

node_modules
*.tsbuildinfo
dist
dist-ssr
*.local
.next

# Editor directories and files
.vscode/*
!.vscode/extensions.json
.idea
.DS_Store
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?


# Compiler files
cache/
out/
*.tsbuildinfo

# Bun (project uses npm — bun.lockb should not be committed)
bun.lockb

# Ignores development broadcast logs
!/broadcast
/broadcast/*/31337/
/broadcast/**/dry-run/

# Dotenv file
.env

.vercel
.env*.local

#Claude
.mcp.json
.claude/settings.local.json

# Worktree / agent harness config (local, not shared)
.superset/

.stryker-tmp/

# External workspaces — upstream repos vendored read-only for agent context.
# Rebuilt on demand by `/prime` (or `/sync-externals`) from .claude/externals.json.
.external/

# Husky — commit the hook scripts (.husky/post-merge etc.) but not the
# auto-generated dispatcher in .husky/_/, which is regenerated on
# `npm install` via the `prepare` script.
.husky/_/
